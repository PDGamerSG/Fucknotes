<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Compose paints the whole UI, so the platform theme only has to provide a splash-free,
      chrome-free window that lets edge-to-edge take over.
    -->
    <style name="Theme.Fucknotes" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <!--
          The app runs with the system bars hidden. Without this the window is letterboxed away
          from the cutout the moment the status bar goes, leaving a black band across the top;
          shortEdges lets it fill the panel, and the UI keeps clear of the lens through the
          display-cutout insets instead.
        -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
    </style>
</resources>
